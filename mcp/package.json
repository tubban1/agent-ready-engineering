{
  "name": "are-mcp",
  "version": "0.12.0",
  "private": true,
  "description": "MCP server for the Agent-Ready Engineering framework: knowledge, local workspace checks and workflow prompts for consultants, engineers, governance and decision makers (stdio)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts conformance/*.test.mjs ../benchmark/agent-tool-design/runner.test.mjs",
    "protocol:probe": "node conformance/probe.mjs",
    "typecheck": "tsc --noEmit",
    "audit:local": "node dist/src/audit-gate-cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "yaml": "2.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "tsx": "4.19.2",
    "typescript": "^5.9.3"
  },
  "bin": {
    "are-mcp": "dist/src/index.js"
  }
}
