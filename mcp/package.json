{
  "name": "are-mcp",
  "version": "0.5.1",
  "private": true,
  "description": "MCP server for the Agent-Ready Engineering framework: knowledge, local workspace checks and workflow prompts for consultants, engineers, governance and decision makers (stdio)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "yaml": "2.6.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  },
  "bin": {
    "are-mcp": "dist/src/index.js"
  }
}
